/* Convert PC2 reading to battery mV using divider ratio */
static uint32_t battery_read_millivolts(void)
{
    uint32_t acc = 0;
    for (int i = 0; i < BAT_MOVAVG_SAMPLES; i++) {
        acc += adc_read_raw_once(BAT_ADC_CHANNEL);
    }
    uint32_t raw_avg = acc / BAT_MOVAVG_SAMPLES;

    uint32_t vadc_mv = (raw_avg * VDDA_MV_NOMINAL) / 4095U;
    uint32_t vbat_mv = (uint32_t)((float)vadc_mv * BAT_DIV_RATIO + 0.5f);
    return vbat_mv;
}

static uint8_t battery_mv_to_percent(uint32_t mv)
{
    if (mv <= 3300) return 0;
    if (mv >= 4200) return 100;
    if (mv < 3600)      return (uint8_t)((mv - 3300) * 15 / 300);
    else if (mv < 3800) return (uint8_t)(15 + (mv - 3600) * 40 / 200);
    else if (mv < 4000) return (uint8_t)(55 + (mv - 3800) * 30 / 200);
    else                return (uint8_t)(85 + (mv - 4000) * 15 / 200);
}





static void adc_single_read_diag(void)
{
    /* Select ch3 using COMMON_1 sampling */
    ADC_ChannelConfTypeDef s = {0};
    s.Channel      = ADC_CHANNEL_3;               // PC2 -> ADC1_IN3
    s.Rank         = ADC_REGULAR_RANK_1;
    s.SamplingTime = ADC_SAMPLINGTIME_COMMON_1;
    s.SingleDiff   = ADC_SINGLE_ENDED;
    s.OffsetNumber = ADC_OFFSET_NONE;

    HAL_StatusTypeDef st_cfg = HAL_ADC_ConfigChannel(&hadc1, &s);
    HAL_StatusTypeDef st_st  = HAL_ADC_Start(&hadc1);
    HAL_StatusTypeDef st_pf  = HAL_ADC_PollForConversion(&hadc1, 10);
    uint32_t          dr     = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);

    /* Snapshot the key SFRs (volatile reads) */
    uint32_t isr   = hadc1.Instance->ISR;
    uint32_t cr    = hadc1.Instance->CR;
    uint32_t cfgr1 = hadc1.Instance->CFGR1;
    uint32_t sqr1  = hadc1.Instance->SQR1;
    uint32_t pcsel = hadc1.Instance->PCSEL;

    /* Decode a few fields for readability */
    uint32_t adstart = (cr >> 2) & 1U;
    uint32_t eoc     = (isr >> 2) & 1U;
    uint32_t eos     = (isr >> 3) & 1U;
    uint32_t l_len   = (sqr1 & 0xF);                // sequence length L
    uint32_t sq1     = (sqr1 >> 6) & 0x3F;          // SQ1 channel number
    uint32_t ch3en   = (pcsel >> 3) & 1U;           // PCSEL[3]
    uint32_t dmngt   = (cfgr1 >> 0) & 0x3;          // DMNGT bits [1:0] (0=DR)
    uint32_t res     = (cfgr1 >> 2) & 0x3;          // RES bits [3:2] (0=12-bit)

    char buf[256];
    int n = snprintf(buf, sizeof(buf),
        "ADC diag: cfg=%d start=%d poll=%d | ISR EOC=%lu EOS=%lu | "
        "PCSEL[ch3]=%lu SQR1{L=%lu,SQ1=%lu} CFGR1{DMNGT=%lu,RES=%lu} | DR=%lu (0x%lX) raw12=%lu\r\n",
        (int)st_cfg, (int)st_st, (int)st_pf,
        (unsigned long)eoc, (unsigned long)eos,
        (unsigned long)ch3en, (unsigned long)l_len, (unsigned long)sq1,
        (unsigned long)dmngt, (unsigned long)res,
        (unsigned long)dr, (unsigned long)dr, (unsigned long)(dr & 0x0FFF));

    HAL_UART_Transmit(&huart2, (uint8_t*)buf, (uint16_t)n, 20);
}




static void adc_enable_and_read_diag(void)
{
    ADC_TypeDef *A = hadc1.Instance;

    /* Configure channel 3 */
    ADC_ChannelConfTypeDef s = (ADC_ChannelConfTypeDef){0};
    s.Channel      = ADC_CHANNEL_3;
    s.Rank         = ADC_REGULAR_RANK_1;
    s.SamplingTime = ADC_SAMPLINGTIME_COMMON_1;
    s.SingleDiff   = ADC_SINGLE_ENDED;
    s.OffsetNumber = ADC_OFFSET_NONE;
    HAL_StatusTypeDef st_cfg = HAL_ADC_ConfigChannel(&hadc1, &s);

    /* Clear EOC/EOS and run one conversion */
    A->ISR = (ADC_FLAG_EOC | ADC_FLAG_EOS | ADC_FLAG_OVR);
    HAL_StatusTypeDef st_st  = HAL_ADC_Start(&hadc1);
    HAL_StatusTypeDef st_pf  = HAL_ADC_PollForConversion(&hadc1, 50);
    uint32_t dr12 = HAL_ADC_GetValue(&hadc1) & 0x0FFFU;
    HAL_ADC_Stop(&hadc1);

    uint32_t isr   = A->ISR;
    uint32_t cr    = A->CR;
    uint32_t cfgr1 = A->CFGR1;
    uint32_t sqr1  = A->SQR1;
    uint32_t pcsel = A->PCSEL;

    uint32_t aden  = (cr & ADC_CR_ADEN) ? 1U : 0U;
    uint32_t rdy   = (isr & ADC_FLAG_ADRDY) ? 1U : 0U;
    uint32_t eoc   = (isr >> 2) & 1U;
    uint32_t eos   = (isr >> 3) & 1U;
    uint32_t l_len = (sqr1 & 0xF);
    uint32_t sq1   = (sqr1 >> 6) & 0x3F;
    uint32_t ch3en = (pcsel >> 3) & 1U;
    uint32_t dmngt = (cfgr1 & 0x3);
    uint32_t res   = (cfgr1 >> 2) & 0x3;

    char buf[200];
    int n = snprintf(buf, sizeof(buf),
        "ADCen=%lu RDY=%lu start=%d poll=%d | PCSEL3=%lu SQR1{L=%lu,SQ1=%lu} CFGR1{DMNGT=%lu,RES=%lu} | RAW12=%lu EOC=%lu EOS=%lu\r\n",
        aden, rdy, (int)st_st, (int)st_pf,
        ch3en, l_len, sq1, dmngt, res, (unsigned long)dr12, eoc, eos);
    HAL_UART_Transmit(&huart2, (uint8_t*)buf, (uint16_t)n, 30);
}

/* Bring ADC1 out of deep power-down, enable regulator, calibrate, enable */
static void adc1_powerup_enable(void)
{
    ADC_TypeDef *A = hadc1.Instance;

    /* Clear any stale flags */
    A->ISR = (ADC_FLAG_LDORDY | ADC_FLAG_ADRDY | ADC_FLAG_EOC | ADC_FLAG_EOS | ADC_FLAG_OVR);

    /* 1) Exit deep-power-down */
#ifdef ADC_CR_DEEPPWD
    if (A->CR & ADC_CR_DEEPPWD) {
        A->CR &= ~ADC_CR_DEEPPWD;
    }
#endif

    /* 2) Enable the ADC internal regulator (ADVREGEN) */
#ifdef ADC_CR_ADVREGEN
    A->CR |= ADC_CR_ADVREGEN;
#endif

    /* Wait for regulator ready (LDORDY) */
    uint32_t t0 = HAL_GetTick();
    while ((A->ISR & ADC_FLAG_LDORDY) == 0U) {
        if ((HAL_GetTick() - t0) > 10U) break;
    }

    /* 3) Optional: calibration via HAL (handles proper sequence) */
#if defined(ADC_CALIB_OFFSET_LINEARITY)
    (void)HAL_ADCEx_Calibration_Start(&hadc1, ADC_CALIB_OFFSET_LINEARITY, ADC_SINGLE_ENDED);
#else
    (void)HAL_ADCEx_Calibration_Start(&hadc1);
#endif

    /* 4) Enable ADC (ADEN) and wait for RDY */
#ifdef ADC_CR_ADEN
    A->CR |= ADC_CR_ADEN;
#endif
    t0 = HAL_GetTick();
    while ((A->ISR & ADC_FLAG_ADRDY) == 0U) {
        if ((HAL_GetTick() - t0) > 10U) break;
    }
}

static uint16_t adc_read_raw_once(uint32_t channel)
{
    ADC_ChannelConfTypeDef sConfig = (ADC_ChannelConfTypeDef){0};
    sConfig.Channel      = channel;                    // ADC_CHANNEL_3 (PC2 -> ADC1_IN3)
    sConfig.Rank         = ADC_REGULAR_RANK_1;
    sConfig.SamplingTime = ADC_SAMPLINGTIME_COMMON_1;  // selects 391 cycles we set above
    sConfig.SingleDiff   = ADC_SINGLE_ENDED;
    sConfig.OffsetNumber = ADC_OFFSET_NONE;

    if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK) return 0;
    if (HAL_ADC_Start(&hadc1) != HAL_OK)                    return 0;
    if (HAL_ADC_PollForConversion(&hadc1, 50) != HAL_OK)    return 0;

    uint16_t raw = (uint16_t)(HAL_ADC_GetValue(&hadc1) & 0x0FFFU);
    HAL_ADC_Stop(&hadc1);
    return raw;
}

/* ==== U5 ADC bring-up: regulator -> delay -> calibrate -> enable ==== */
static void adc1_bringup(void)
{
    /* 1) Try HAL helper if present */
#if defined(HAL_ADC_MODULE_ENABLED) && defined(HAL_ADC_EXPORTED_FUNCTIONS)
  #if defined(HAL_ADCEx_EnableVoltageRegulator)
    HAL_ADCEx_EnableVoltageRegulator(&hadc1);
    HAL_Delay(2);  /* ~> tADCVREG_STUP */
  #endif

  /* Optional calibration (safe to call even if already calibrated) */
  #if defined(ADC_CALIB_OFFSET_LINEARITY)
    (void)HAL_ADCEx_Calibration_Start(&hadc1, ADC_CALIB_OFFSET_LINEARITY, ADC_SINGLE_ENDED);
  #else
    (void)HAL_ADCEx_Calibration_Start(&hadc1);
  #endif

  /* Enable ADC (HAL will set ADEN) */
  (void)HAL_ADC_Start(&hadc1);
  (void)HAL_ADC_Stop(&hadc1);

#else
    /* 2) Fallback: do the essentials via registers */
    ADC_TypeDef *A = hadc1.Instance;

    /* Clear stale flags */
    A->ISR = (ADC_FLAG_EOC | ADC_FLAG_EOS | ADC_FLAG_OVR
    #ifdef ADC_FLAG_RDY
             | ADC_FLAG_RDY
    #endif
    #ifdef ADC_FLAG_LDORDY
             | ADC_FLAG_LDORDY
    #endif
             );

    /* Exit deep power-down and enable regulator if bits exist */
    #ifdef ADC_CR_DEEPPWD
      A->CR &= ~ADC_CR_DEEPPWD;
    #endif
    #ifdef ADC_CR_ADVREGEN
      A->CR |= ADC_CR_ADVREGEN;
    #endif

    HAL_Delay(2); /* allow regulator to settle */

    /* Calibrate via HAL if available, else skip */
    #if defined(ADC_CALIB_OFFSET_LINEARITY)
      (void)HAL_ADCEx_Calibration_Start(&hadc1, ADC_CALIB_OFFSET_LINEARITY, ADC_SINGLE_ENDED);
    #elif defined(HAL_ADCEx_Calibration_Start)
      (void)HAL_ADCEx_Calibration_Start(&hadc1);
    #endif

    /* Enable ADC core */
    #ifdef ADC_CR_ADEN
      A->CR |= ADC_CR_ADEN;
    #endif

    HAL_Delay(1); /* small guard */
#endif
}







