/* USER CODE BEGIN 4 */
/* --------- ISM330DHCX bring-up (BDU + IF_INC + 1.04 kHz ODR) ---------- */
static void Initialize_Sensors(void)
{
  uint8_t tx_data[2];
  uint8_t who_am_i_val = 0;

  /* WHO_AM_I read: 0x0F | 0x80 (read) */
  uint8_t tx_buf[2] = { (uint8_t)(0x0F | 0x80), 0x00 };
  uint8_t rx_buf[2] = { 0 };

  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  HAL_SPI_TransmitReceive(&hspi2, tx_buf, rx_buf, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

  who_am_i_val = rx_buf[1];
  if (who_am_i_val != 0x6B) {
    /* Sensor not detected */
    Error_Handler();
  }

  /* CTRL3_C (0x12): BDU=1 (bit6), IF_INC=1 (bit2) */
  tx_data[0] = 0x12; tx_data[1] = 0x44;
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi2, tx_data, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

  /* CTRL1_XL (0x10): ODR ~1.04 kHz (0x80), keep FS default */
  tx_data[0] = 0x10; tx_data[1] = 0x80;
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi2, tx_data, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

  /* CTRL2_G (0x11): ODR ~1.04 kHz (0x80), keep FS default */
  tx_data[0] = 0x11; tx_data[1] = 0x80;
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi2, tx_data, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

  HAL_Delay(100); /* settle */
}

/* Start a single chained read (OUTX_L_G .. OUTZ_H_XL) via DMA on SPI2 */
static void start_sensor_read(void)
{
  /* First byte is the command (0x22 | read | auto-inc) */
  ism330dhcx_tx_dma_buf[0] = (uint8_t)(0x22 | 0x80);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);

  if (HAL_SPI_TransmitReceive_DMA(&hspi2,
                                  ism330dhcx_tx_dma_buf,
                                  ism330dhcx_rx_dma_buf,
                                  ISM330DHCX_DMA_LEN) != HAL_OK) {
    Error_Handler();
  }
}

