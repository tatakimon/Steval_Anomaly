    if (HAL_RTC_SetDate(&hrtc, &sDate, RTC_FORMAT_BIN) != HAL_OK) { Error_Handler(); }
  }
  /* USER CODE END Set_RTC_Time */






  //MX_SAI1_Init();
  MX_SDMMC1_SD_Init();
  //MX_SPI1_Init();
  MX_SPI2_Init();
  //MX_SPI3_Init();
  MX_TAMP_RTC_Init();
  //MX_TIM3_Init();
  MX_USART2_UART_Init();
  //MX_USART3_UART_Init();
  //MX_USB_OTG_FS_PCD_Init();
  MX_FileX_Init();


  /* USER CODE BEGIN 2
   * Bring up sensor, open SD media, open/append log file, take RTC anchor. */
  Initialize_Sensors();

  /* Mount SD */
  {
    UINT st = fx_media_open(&sd_media, "SD_DISK",
                            fx_stm32_sd_driver, (VOID*)&hsd1,
                            media_buffer, sizeof(media_buffer));
    if (st != FX_SUCCESS) {
      char msg[80]; int n = snprintf(msg, sizeof msg, "fx_media_open: 0x%08X\r\n", st);
      if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)msg, (uint16_t)n, HAL_MAX_DELAY);
      run_logging = 0; Error_Handler();
    }
  }

  /* Open file for append (create if needed) */
  {
    UINT st = fx_file_open(&sd_media, &log_file, "datalog.jsonl", FX_OPEN_FOR_WRITE);
    if (st == FX_NOT_FOUND) {
      st = fx_file_create(&sd_media, "datalog.jsonl");
      if (st != FX_SUCCESS) {
        char msg[80]; int n = snprintf(msg, sizeof msg, "fx_file_create: 0x%08X\r\n", st);
        if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)msg, (uint16_t)n, HAL_MAX_DELAY);
        run_logging = 0; Error_Handler();
      }
      st = fx_file_open(&sd_media, &log_file, "datalog.jsonl", FX_OPEN_FOR_WRITE);
    }
    if (st != FX_SUCCESS) {
      char msg[80]; int n = snprintf(msg, sizeof msg, "fx_file_open: 0x%08X\r\n", st);
      if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)msg, (uint16_t)n, HAL_MAX_DELAY);
      run_logging = 0; Error_Handler();
    }
    /* Seek to end for append mode */
    fx_file_seek(&log_file, log_file.fx_file_current_file_size);
  }

  /* Capture RTC anchor once (start-of-session) */
  {
    RTC_TimeTypeDef t0; RTC_DateTypeDef d0;
    HAL_RTC_GetTime(&hrtc, &t0, RTC_FORMAT_BIN);
    HAL_RTC_GetDate(&hrtc, &d0, RTC_FORMAT_BIN);
    anchor_year  = d0.Year;  anchor_month = d0.Month; anchor_date = d0.Date;
    anchor_hour  = t0.Hours; anchor_min   = t0.Minutes; anchor_sec  = t0.Seconds;
    anchor_ms    = sample_count_ms;  // likely 0 at boot
  }

  /* Optional: first read “kick” — safe to keep; sampling is loop-paced too */
  {
    static uint32_t last_sample_tick = 0;
    uint32_t now = HAL_GetTick();
    if (!spi_busy) {
      if (((uint32_t)(now - last_sample_tick) >= 1U) || (now == last_sample_tick)) {
        last_sample_tick = now;
        dbg_last_sample_gate_ms = now;
        start_sensor_read();
      }
    }
  }
  /* USER CODE END 2 */



  /* Infinite loop */
  /* USER CODE BEGIN WHILE */


  while (1)
   {
     /* USER CODE END WHILE */

     /* USER CODE BEGIN 3 */
     if (!run_logging) { heartbeat_tick(); safe_debug_tick(); continue; }

     /* ---- 1) Pace at ~1 kHz (guarded by spi_busy) ---- */
     {
       static uint32_t last_sample_tick = 0;
       uint32_t now = HAL_GetTick();
       if (!spi_busy && ( ((uint32_t)(now - last_sample_tick) >= 1U) || (last_sample_tick == 0) )) {
         last_sample_tick = now;
         dbg_last_sample_gate_ms = now;
         start_sensor_read();
       }
     }

     /* ---- 2) Process a completed DMA frame ---- */
     if (g_data_ready) {
       g_data_ready = 0;                    // consume flag

       SensorSample_t s;                    // parse 12-byte payload into struct
       s.timestamp_ms        = sample_count_ms;  // logical time (deterministic)

       /* Gyro 3x int16 (little endian) */
       s.ism330_gyro.x  = (int16_t)((ism330dhcx_rx_buffer[1]  << 8) | ism330dhcx_rx_buffer[0]);
       s.ism330_gyro.y  = (int16_t)((ism330dhcx_rx_buffer[3]  << 8) | ism330dhcx_rx_buffer[2]);
       s.ism330_gyro.z  = (int16_t)((ism330dhcx_rx_buffer[5]  << 8) | ism330dhcx_rx_buffer[4]);
       /* Accel 3x int16 */
       s.ism330_accel.x = (int16_t)((ism330dhcx_rx_buffer[7]  << 8) | ism330dhcx_rx_buffer[6]);
       s.ism330_accel.y = (int16_t)((ism330dhcx_rx_buffer[9]  << 8) | ism330dhcx_rx_buffer[8]);
       s.ism330_accel.z = (int16_t)((ism330dhcx_rx_buffer[11] << 8) | ism330dhcx_rx_buffer[10]);


       /* warmup: count down parsed samples */
       if (!warmup_auto_start_done && warmup_reads_remaining > 0) {
           warmup_reads_remaining--;
       }



       /* Motion gates (choose one). Currently using displacement gate: */
       update_displacement_gate(&s);
       /* update_activity_gate(&s);  // (available, but not used now) */

       /* If capturing, push into circular window and advance logical time */
       if (capture_mode) {
         circular_buffer[buffer_head] = s;
         buffer_head  = (buffer_head + 1) % CIRCULAR_BUFFER_SIZE;
         if (buffer_count < CIRCULAR_BUFFER_SIZE) buffer_count++;
         sample_count_ms++;                 // advance logical ms only for stored samples
         dbg_samples_pushed++;
       }
     }

     /* ---- 3) When window is full, serialize to JSONL and write ---- */
     if (buffer_count >= CIRCULAR_BUFFER_SIZE) {
       static char json_buffer[12800];      // big local buffer
       int total_bytes = 0;

       /* Oldest index in chronological order when full */
       uint32_t start = (buffer_head + CIRCULAR_BUFFER_SIZE - buffer_count) % CIRCULAR_BUFFER_SIZE;

       for (int i = 0; i < CIRCULAR_BUFFER_SIZE; i++) {
         size_t space_left = sizeof(json_buffer) - (size_t)total_bytes;
         if (space_left <= 1) break;

         /* Chronological index */
         uint32_t idx = (start + (uint32_t)i) % CIRCULAR_BUFFER_SIZE;

         /* Convert logical ms -> anchored wall time (no date carry across days) */
         uint32_t elapsed_ms = circular_buffer[idx].timestamp_ms - anchor_ms;



         /* One compact line: elapsed_ms + raw values (values now ALSO from idx) */
            int n = snprintf(&json_buffer[total_bytes], space_left,
                "{\"elapsed_ms\":%lu,"
                "\"gyro\":{\"x\":%d,\"y\":%d,\"z\":%d},"
                "\"accel\":{\"x\":%d,\"y\":%d,\"z\":%d}}\r\n",
                (unsigned long)elapsed_ms,
                circular_buffer[idx].ism330_gyro.x,  circular_buffer[idx].ism330_gyro.y,  circular_buffer[idx].ism330_gyro.z,
                circular_buffer[idx].ism330_accel.x, circular_buffer[idx].ism330_accel.y, circular_buffer[idx].ism330_accel.z);

         if (n < 0) break;                         // snprintf error
         if ((size_t)n >= space_left) {            // truncated: cap and stop
           total_bytes = (int)sizeof(json_buffer) - 1;
           break;
         }
         total_bytes += n;
       }

       /* Optional: drop window writes for debug (set debug_drop_windows=1 in debugger) */
       if (!debug_drop_windows) {
           uint32_t write_t0 = HAL_GetTick();
           UINT st = fx_file_write(&log_file, json_buffer, (ULONG)total_bytes);
           uint32_t write_dt = HAL_GetTick() - write_t0;

           window_seq++;  /* increment for this window */
           debug_echo_window(json_buffer, total_bytes);  /* mirror to UART */

           dbg_windows_written++;
           if (st != FX_SUCCESS) dbg_fx_write_errs++;

           /* Short debug line */
           {
               char wmsg[128];
               int wn = snprintf(wmsg, sizeof(wmsg),
                                 "WIN #%lu bytes=%d write=%lums st=0x%02X\r\n",
                                 (unsigned long)window_seq, total_bytes,
                                 (unsigned long)write_dt, (unsigned)st);
               if (wn > 0) HAL_UART_Transmit(&huart2, (uint8_t*)wmsg, (uint16_t)wn, 20);
           }
       } else {
           window_seq++;
           debug_echo_window(json_buffer, total_bytes);  /* still echo, but skip SD */
           {
               char wmsg[96];
               int wn = snprintf(wmsg, sizeof(wmsg),
                                 "WIN #%lu (SKIPPED WRITE) bytes=%d\r\n",
                                 (unsigned long)window_seq, total_bytes);
               if (wn > 0) HAL_UART_Transmit(&huart2, (uint8_t*)wmsg, (uint16_t)wn, 20);
           }
       }

     /* ---- 4) Once-per-second status line ---- */
     {
       uint32_t tnow = HAL_GetTick();
       if ((tnow - dbg_last_1s_ms) >= 1000U) {
         dbg_last_1s_ms = tnow;
         char line[200];
         int n = snprintf(line, sizeof(line),
           "[%lu] starts=%lu cb=%lu cb_same_ms=%lu samples=%lu win=%lu busy_err=%lu start_busy=%lu gate_ms=%lu\r\n",
           (unsigned long)tnow,
           (unsigned long)dbg_dma_starts,
           (unsigned long)dbg_dma_cb,
           (unsigned long)dbg_cb_same_ms,
           (unsigned long)dbg_samples_pushed,
           (unsigned long)dbg_windows_written,
           (unsigned long)spi_dma_busy_err_cnt,
           (unsigned long)dbg_start_while_busy,
           (unsigned long)dbg_last_sample_gate_ms);
         if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)line, (uint16_t)n, 20);
       }
     }

     /* Housekeeping */
     heartbeat_tick();
     safe_debug_tick();
     /* USER CODE END 3 */
   }
 }
