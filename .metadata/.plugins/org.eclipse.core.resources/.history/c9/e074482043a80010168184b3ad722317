/* ---------- Float problem solvers ---------- */
static inline long to_u1e6(float x)   { return (long)(x * 1000000.0f); }   // micro-units
static inline long to_u1e3(float x)   { return (long)(x * 1000.0f); }      // milli-units
static inline long to_u1e4(float x)   { return (long)(x * 10000.0f); }     // 1e-4 units


/* ---------- Helpers ---------- */
static inline int32_t sqi16(int16_t v) { return (int32_t)v * (int32_t)v; }
static inline float lsb_to_mps2(int16_t raw)
{
  return (float)raw * ACC_SENS_MG_PER_LSB * 1e-3f * GRAVITY_MPS2;
}


/* ====== Pure C helpers for echoing SD window content over UART ====== */
static int debug_count_lines(const char* buf, int len)
{
    int lines = 0;
    const char* p = buf;
    const char* end = buf + len;
    while (p < end) {
        const void* nl = memchr(p, '\n', (size_t)(end - p));
        if (!nl) break;
        lines++;
        p = ((const char*)nl) + 1;
    }
    return lines;
}

/* Print up to k lines from *pp (advances *pp) */
static void debug_print_k_lines(UART_HandleTypeDef* huart, const char** pp,
                                const char* end, int k)
{
    int i;
    const char* cur = *pp;
    for (i = 0; i < k && cur < end; i++) {
        const void* nl = memchr(cur, '\n', (size_t)(end - cur));
        int chunk = nl ? (int)((const char*)nl - cur + 1) : (int)(end - cur);
        if (chunk <= 0) break;
        HAL_UART_Transmit(huart, (uint8_t*)cur, (uint16_t)chunk, 400);
        cur += chunk;
    }
    *pp = cur;
}

/* Echo the JSON window to UART in manageable chunks */
static void debug_echo_window(const char* buf, int len)
{
    if (!debug_sd_echo || buf == NULL || len <= 0) return;

    const char* p   = buf;
    const char* end = buf + len;
    int total_lines = debug_count_lines(buf, len);
    char tmp[120];
    int n;

    /* Header */
    n = snprintf(tmp, sizeof tmp,
                 "[ECHO] window #%lu bytes=%d lines=%d\r\n",
                 (unsigned long)window_seq, len, total_lines);
    if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)tmp, (uint16_t)n, 100);

    if (total_lines <= debug_sd_echo_max_lines) {
        /* Print all lines */
        debug_print_k_lines(&huart2, &p, end, total_lines);
    } else if (debug_sd_echo_head_tail) {
        /* Print head + tail */
        int head = (int)(debug_sd_echo_max_lines / 2);
        int tail = (int)(debug_sd_echo_max_lines - head);
        if (head < 1) head = 1;
        if (tail < 1) tail = 1;

        /* Head */
        debug_print_k_lines(&huart2, &p, end, head);

        /* Ellipsis marker */
        static const char dots[] = "[...]\r\n";
        HAL_UART_Transmit(&huart2, (const uint8_t*)dots, (uint16_t)(sizeof dots - 1), 50);

        /* Find start of last 'tail' lines */
        const char* q = end;
        int need = tail;
        while (q > buf && need > 0) {
            q--;
            if (*q == '\n') need--;
        }
        if (q < buf) q = buf;

        /* Tail */
        if (q < end) {
            HAL_UART_Transmit(&huart2, (uint8_t*)q, (uint16_t)(end - q), 400);
        }
    } else {
        /* Print first N lines only */
        debug_print_k_lines(&huart2, &p, end, debug_sd_echo_max_lines);
    }

    /* Footer */
    n = snprintf(tmp, sizeof tmp, "[ECHO] done\r\n");
    if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)tmp, (uint16_t)n, 50);
}






/* Write a single JSONL event line with RTC timestamp.
   event_str: "start" or "stop"
   idle_ms  : pass 0 for "stop"; for "start" pass computed idle duration. */
static void log_event_line(const char* event_str, uint32_t idle_ms)
{
    RTC_TimeTypeDef t; RTC_DateTypeDef d;
    HAL_RTC_GetTime(&hrtc, &t, RTC_FORMAT_BIN);
    HAL_RTC_GetDate(&hrtc, &d, RTC_FORMAT_BIN);

    char line[160];
    int n;
    if (idle_ms == 0) {
        // stop line (no idle_ms field)
        n = snprintf(line, sizeof line,
            "{\"event\":\"%s\",\"rtc\":\"20%02u-%02u-%02u %02u:%02u:%02u\"}\r\n",
            event_str, d.Year, d.Month, d.Date, t.Hours, t.Minutes, t.Seconds);
    } else {
        // start line (includes prior idle duration)
        n = snprintf(line, sizeof line,
            "{\"event\":\"%s\",\"rtc\":\"20%02u-%02u-%02u %02u:%02u:%02u\",\"idle_ms\":%lu}\r\n",
            event_str, d.Year, d.Month, d.Date, t.Hours, t.Minutes, t.Seconds,
            (unsigned long)idle_ms);
    }
    if (n > 0) {
        UINT st = fx_file_write(&log_file, line, (ULONG)n);
        (void)st; // optionally check status
    }
}








/* ---------- Displacement-based two-phase capture gate ---------- */
static void update_displacement_gate(const SensorSample_t* s)
{

	/* ---- Warmup auto-start (one-shot) ---- */
	extern volatile uint16_t warmup_reads_remaining;
	extern volatile uint8_t  warmup_auto_start_done;
	extern uint32_t capture_anchor_ms;     // if you use elapsed_ms anchoring
	extern volatile uint8_t  capture_mode;
	extern volatile uint16_t entry_hold, exit_hold;
	extern volatile uint32_t buffer_count;

	if (!warmup_auto_start_done && (warmup_reads_remaining == 0)) {
	    if (!capture_mode) {
	        capture_mode = 1;
	        entry_hold = 0;
	        exit_hold  = 0;
	        buffer_count = 0;
	        capture_anchor_ms = sample_count_ms;   // keep your elapsed_ms monotonic

	        /* (optional) START event line here, if you log events */
	        // log_event_line("start", /*idle_ms*/0);

	        /* small notice */
	        { char m[] = "CAPTURE: START (warmup)\r\n";
	          HAL_UART_Transmit(&huart2, (uint8_t*)m, sizeof m - 1, 10); }
	    }
	    warmup_auto_start_done = 1;  // don’t auto-start again
	    /* continue into Phase B (CAPTURE) or just return; either is fine */
	}








  /* Convert accel to m/s^2 and remove gravity with a slow LPF */
  float ax = lsb_to_mps2(s->ism330_accel.x);
  float ay = lsb_to_mps2(s->ism330_accel.y);
  float az = lsb_to_mps2(s->ism330_accel.z);

  acc_lp[0] += GRAV_LPF_ALPHA * (ax - acc_lp[0]);
  acc_lp[1] += GRAV_LPF_ALPHA * (ay - acc_lp[1]);
  acc_lp[2] += GRAV_LPF_ALPHA * (az - acc_lp[2]);

  float ahx = ax - acc_lp[0];
  float ahy = ay - acc_lp[1];
  float ahz = az - acc_lp[2];

  /* Integrate with small leaks to limit drift */
  vel_mps[0] = (vel_mps[0] + ahx * DT_SEC) * (1.0f - VEL_LEAK);
  vel_mps[1] = (vel_mps[1] + ahy * DT_SEC) * (1.0f - VEL_LEAK);
  vel_mps[2] = (vel_mps[2] + ahz * DT_SEC) * (1.0f - VEL_LEAK);

  disp_m[0]  = (disp_m[0]  + vel_mps[0] * DT_SEC) * (1.0f - DISP_LEAK);
  disp_m[1]  = (disp_m[1]  + vel_mps[1] * DT_SEC) * (1.0f - DISP_LEAK);
  disp_m[2]  = (disp_m[2]  + vel_mps[2] * DT_SEC) * (1.0f - DISP_LEAK);




  float d2 = disp_m[0]*disp_m[0] + disp_m[1]*disp_m[1] + disp_m[2]*disp_m[2];
  int32_t g2 = sqi16(s->ism330_gyro.x) + sqi16(s->ism330_gyro.y) + sqi16(s->ism330_gyro.z);

  if (!capture_mode) {
    /* Phase A: wait for consistent displacement to START capture */
    if (d2 > ENTRY_DISP_ON_M2) {
      if (++entry_hold >= ENTRY_ON_HOLD_SAMPLES) {
        capture_mode = 1; entry_hold = 0; exit_hold = 0; buffer_count = 0;
        char m[32]; int n = snprintf(m, sizeof m, "CAPTURE: START\r\n");
        if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)m, (uint16_t)n, 10);



        uint32_t idle_ms = 0;
                   if (idle_active) {
                       uint32_t now = HAL_GetTick();
                       idle_ms = (uint32_t)(now - idle_start_tick);  // wrap-safe unsigned math
                   }
                   log_event_line("start", idle_ms);     // include how long we were idle
                   idle_active = 0;                      // back to capturing



        /* --- LOG: one-time anchor line (human clock at capture start) --- */
        {
            RTC_TimeTypeDef t0; RTC_DateTypeDef d0;
            HAL_RTC_GetTime(&hrtc, &t0, RTC_FORMAT_BIN);
            HAL_RTC_GetDate(&hrtc, &d0, RTC_FORMAT_BIN);

            char hdr[96];
            int hn = snprintf(hdr, sizeof hdr,
                "{\"anchor\":\"20%02u-%02u-%02u %02u:%02u:%02u\",\"note\":\"start\"}\r\n",
                d0.Year, d0.Month, d0.Date, t0.Hours, t0.Minutes, t0.Seconds);
            if (hn > 0) {
                UINT st_hdr = fx_file_write(&log_file, hdr, (ULONG)hn);
                (void)st_hdr; // optional: check or count errors
            }
        }



      }
    } else {
      entry_hold = 0;
    }
  } else {
	  // right after: capture_mode = 0; exit_hold = 0; entry_hold = 0; ...





    /* Phase B: keep logging; stop only after sustained stillness */
    if ((d2 < EXIT_DISP_OFF_M2) && (g2 < EXIT_GYRO_E2_THRESH)) {
      if (++exit_hold >= EXIT_OFF_HOLD_SAMPLES) {
        capture_mode = 0; exit_hold = 0; entry_hold = 0;
        memset((void*)vel_mps, 0, sizeof(vel_mps));
        memset((void*)disp_m, 0, sizeof(disp_m));
        char m[32]; int n = snprintf(m, sizeof m, "CAPTURE: STOP\r\n");
        if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)m, (uint16_t)n, 10);



        /* >>> ADD THIS <<< */
          log_event_line("stop", 0);                // one line only
          idle_active     = 1;                      // now in idle
          idle_start_tick = HAL_GetTick();          // remember when idle began
          /* <<< END ADD >>> */





      }
      {
     	      RTC_TimeTypeDef t1; RTC_DateTypeDef d1;
     	      HAL_RTC_GetTime(&hrtc, &t1, RTC_FORMAT_BIN);
     	      HAL_RTC_GetDate(&hrtc, &d1, RTC_FORMAT_BIN);
     	      char f[96];
     	      int fn = snprintf(f, sizeof f,
     	          "{\"anchor\":\"20%02u-%02u-%02u %02u:%02u:%02u\",\"note\":\"stop\"}\r\n",
     	          d1.Year, d1.Month, d1.Date, t1.Hours, t1.Minutes, t1.Seconds);
     	      if (fn > 0) { UINT stf = fx_file_write(&log_file, f, (ULONG)fn); (void)stf; }
     	  }


    } else {
      exit_hold = 0;
    }
  }

  static uint16_t dbg_cnt = 0;
  if (capture_mode && (++dbg_cnt % 200 == 0)) { // ~every 0.2 s
      char msg[112];
      long d2_u1e6 = to_u1e6(d2);  // d2 in micro-m^2
      int n = snprintf(msg, sizeof msg,
          "gate d2_u1e6=%ld g2=%ld exit_hold=%u\r\n",
          d2_u1e6, (long)g2, (unsigned)exit_hold);
      if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)msg, (uint16_t)n, 10);
  }

  static uint16_t dbg_cnt_entry = 0;
  if (!capture_mode && (++dbg_cnt_entry % 200 == 0)) {
      char msg[96];
      long d2_u1e6 = (long)(d2 * 1000000.0f);
      int n = snprintf(msg, sizeof msg,
          "idle d2_u1e6=%ld entry_hold=%u\r\n", d2_u1e6, (unsigned)entry_hold);
      if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)msg, (uint16_t)n, 10);
  }




}


/* ---------- Sensor bring-up ---------- */
static void Initialize_Sensors(void)
{
  char uart_buf[96];

  /* Read WHO_AM_I (0x0F) using SPI2, CS_DHCX (CubeMX pins) */
  uint8_t tx[2] = { (uint8_t)(0x0F | 0x80), 0x00 };  // read bit set
  uint8_t rx[2] = {0};
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  HAL_SPI_TransmitReceive(&hspi2, tx, rx, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);
  uint8_t who = rx[1];

  if (who == 0x6B) {
    int n = snprintf(uart_buf, sizeof uart_buf, "ISM330DHCX WHO_AM_I: OK (0x%02X)\r\n", who);
    if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)uart_buf, (uint16_t)n, HAL_MAX_DELAY);

    /* CTRL3_C (0x12): BDU=1, IF_INC=1  -> 0b0100 0100 = 0x44 */
    uint8_t wr[2] = { 0x12, 0x44 };
    HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, wr, 2, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

    /* CTRL1_XL (0x10): set accel ODR to 1.04 kHz (HP mode) -> 0x80 */
    wr[0] = 0x10; wr[1] = 0x80;
    HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, wr, 2, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

    /* CTRL2_G (0x11): set gyro  ODR to 1.04 kHz (HP mode) -> 0x80 */
    wr[0] = 0x11; wr[1] = 0x80;
    HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, wr, 2, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);
  } else {
    /* NOTE: In your original code, uart_buf was not set in the failure path.
       Here we still avoid changing behavior materially; we just send a clear msg. */
    int n = snprintf(uart_buf, sizeof uart_buf, "ISM330DHCX WHO_AM_I FAIL: 0x%02X\r\n", who);
    if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)uart_buf, (uint16_t)n, HAL_MAX_DELAY);
    Error_Handler();
  }

  HAL_Delay(100); // settle time after config
}

/* ---------- Kick a SPI2 DMA read of 12 bytes (gyro+accel) ---------- */
static void start_sensor_read(void)
{
  if (spi_busy || !run_logging) { dbg_start_while_busy++; return; }

  /* OUTX_L_G = 0x22; use auto-increment (IF_INC=1) to read 12 bytes */
  ism330dhcx_tx_dma_buf[0] = (uint8_t)(0x22 | 0x80);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  spi_busy = 1;

  HAL_StatusTypeDef hs = HAL_SPI_TransmitReceive_DMA(
      &hspi2, ism330dhcx_tx_dma_buf, ism330dhcx_rx_dma_buf, ISM330DHCX_DMA_LEN);

  if (hs != HAL_OK) {
    spi_busy = 0; spi_dma_busy_err_cnt++;  // keep running; count the error
    return;
  }
  spi_dma_start_cnt++; dbg_dma_starts++;
}

/* ---------- SPI DMA completion ---------- */
void HAL_SPI_TxRxCpltCallback(SPI_HandleTypeDef *hspi)
{
  if (hspi->Instance == SPI2) {
    HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

    /* Skip command echo byte; copy only the 12 data bytes */
    memcpy(ism330dhcx_rx_buffer, &ism330dhcx_rx_dma_buf[1], ISM330DHCX_DATA_SIZE);

    g_data_ready = 1;               // let main loop parse
    spi_busy     = 0;
    spi_dma_cplt_cnt++; dbg_dma_cb++;

    /* Simple rate stat: how many callbacks landed in same HAL tick */
    uint32_t now = HAL_GetTick();
    if (now == dbg_cb_last_ms) { dbg_cb_same_ms++; }
    else { dbg_cb_last_ms = now; }
  }
}
