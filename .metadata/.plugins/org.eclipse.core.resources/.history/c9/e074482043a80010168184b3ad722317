static void heartbeat_tick(void)
{
  uint32_t now = HAL_GetTick();
  if ((now - last_heartbeat_ms) >= 250U) {      // 4 Hz heartbeat
    last_heartbeat_ms = now;
    HAL_GPIO_TogglePin(LED_HB_PORT, LED_HB_PIN);
  }
}


static void safe_debug_tick(void)
{
  uint32_t now = HAL_GetTick();
  if ((now - last_debug_ms) >= 1000U) {
    last_debug_ms = now;
    char dbg[128];
    int n = snprintf(dbg, sizeof(dbg),
                     "DMA start=%lu cplt=%lu busy=%lu\r\n",
                     (unsigned long)spi_dma_start_cnt,
                     (unsigned long)spi_dma_cplt_cnt,
                     (unsigned long)spi_dma_busy_err_cnt);
    if (n > 0) HAL_UART_Transmit(&huart2, (uint8_t*)dbg, (uint16_t)n, 10);
  }
}


