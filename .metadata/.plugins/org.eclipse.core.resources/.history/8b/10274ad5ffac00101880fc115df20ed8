static void Initialize_Sensors(void)
{
  /* WHO_AM_I read (2 bytes) */
  uint8_t tx[2] = { (uint8_t)(ISM_REG_WHO_AM_I | ISM_SPI_READ_BIT), 0x00 };
  uint8_t rx[2] = { 0 };

  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  HAL_SPI_TransmitReceive(&hspi2, tx, rx, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

  if (rx[1] != ISM_WHO_AM_I_VAL) {
    Error_Handler();
  }

  /* Enable BDU + Address auto-increment */
  uint8_t cfg[2] = { ISM_REG_CTRL3_C, ISM_CTRL3_C_BDU_INC };
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi2, cfg, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

  /* ODR 1.04 kHz for accel and gyro (scales left at default) */
  uint8_t a_odr[2] = { ISM_REG_CTRL1_XL, ISM_ODR_1040_HZ };
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi2, a_odr, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

  uint8_t g_odr[2] = { ISM_REG_CTRL2_G,  ISM_ODR_1040_HZ };
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi2, g_odr, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);

  HAL_Delay(100);
}

static void Start_SensorRead_DMA(void)
{
  /* Multi-byte read starting at OUTX_L_G (gyro first, then accel) */
  ism_tx_dma_buf[0] = (uint8_t)(ISM_REG_OUTX_L_G | ISM_SPI_READ_BIT);

  HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_RESET);
  if (HAL_SPI_TransmitReceive_DMA(&hspi2, ism_tx_dma_buf, ism_rx_dma_buf, ISM_DMA_FRAME) != HAL_OK) {
    HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);
    Error_Handler();
  }
}

/* SPI TxRx complete callback (called after DMA completes) */
void HAL_SPI_TxRxCpltCallback(SPI_HandleTypeDef *hspi)
{
  if (hspi->Instance == SPI2) {
    HAL_GPIO_WritePin(CS_DHCX_GPIO_Port, CS_DHCX_Pin, GPIO_PIN_SET);
    /* skip first byte (command), copy data bytes */
    memcpy(ism_rx_data, &ism_rx_dma_buf[1], ISM_DMA_DATA_BYTES);
    g_data_ready = 1;
  }
}


