/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();


  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  SystemPower_Config();
  SystemClock_Config();
  PeriphCommonClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_GPDMA1_Init();
  MX_ICACHE_Init();
  MX_RTC_Init();
  MX_SDMMC1_SD_Init();
  MX_SPI2_Init();
  MX_TAMP_RTC_Init();
  MX_USART2_UART_Init();
  MX_FileX_Init();
  /* USER CODE BEGIN 2 */
  /* Set an initial RTC date/time (example) */
  {
    RTC_TimeTypeDef t = {0};
    RTC_DateTypeDef d = {0};

    t.Hours = 16; t.Minutes = 39; t.Seconds = 0;
    t.DayLightSaving = RTC_DAYLIGHTSAVING_NONE;
    t.StoreOperation = RTC_STOREOPERATION_RESET;
    if (HAL_RTC_SetTime(&hrtc, &t, RTC_FORMAT_BIN) != HAL_OK) Error_Handler();

    d.WeekDay = RTC_WEEKDAY_FRIDAY;
    d.Month   = RTC_MONTH_SEPTEMBER;
    d.Date    = 19;
    d.Year    = 25; /* 2025 */
    if (HAL_RTC_SetDate(&hrtc, &d, RTC_FORMAT_BIN) != HAL_OK) Error_Handler();
  }

  /* Sensor init (WHO_AM_I + ODR + BDU/INC) */
  Initialize_Sensors();

  /* FileX: open media & file once; append mode */
  {
    UINT fx_stat = fx_media_open(&sd_media, "SD_DISK",
                                 fx_stm32_sd_driver, (VOID*)&hsd1,
                                 media_buffer, sizeof(media_buffer));
    if (fx_stat != FX_SUCCESS) Error_Handler();

    fx_stat = fx_file_open(&sd_media, &log_file, "datalog.jsonl", FX_OPEN_FOR_WRITE);
    if (fx_stat == FX_NOT_FOUND) {
      fx_file_create(&sd_media, "datalog.jsonl");
      fx_stat = fx_file_open(&sd_media, &log_file, "datalog.jsonl", FX_OPEN_FOR_WRITE);
    }
    if (fx_stat != FX_SUCCESS) Error_Handler();

    fx_file_seek(&log_file, log_file.fx_file_current_file_size);
  }

  /* Kick first DMA read */
  Start_SensorRead_DMA();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    /* 1 kHz pacing for DMA starts (non-blocking) */
    uint32_t now = HAL_GetTick();
    if ((now - last_sample_tick) >= 1u) {
      last_sample_tick = now;
      Start_SensorRead_DMA();
    }

    /* Push a sample into circular buffer when DMA completes */
    if (g_data_ready) {
      g_data_ready = 0;

      SensorSample_t s;
      s.timestamp_ms = HAL_GetTick();

      s.ism330_gyro.x  = (int16_t)((ism_rx_data[1]  << 8) | ism_rx_data[0]);
      s.ism330_gyro.y  = (int16_t)((ism_rx_data[3]  << 8) | ism_rx_data[2]);
      s.ism330_gyro.z  = (int16_t)((ism_rx_data[5]  << 8) | ism_rx_data[4]);
      s.ism330_accel.x = (int16_t)((ism_rx_data[7]  << 8) | ism_rx_data[6]);
      s.ism330_accel.y = (int16_t)((ism_rx_data[9]  << 8) | ism_rx_data[8]);
      s.ism330_accel.z = (int16_t)((ism_rx_data[11] << 8) | ism_rx_data[10]);

      circular_buffer[buf_head] = s;
      buf_head = (buf_head + 1u) % CIRCULAR_BUFFER_SIZE;
      if (buf_count < CIRCULAR_BUFFER_SIZE) buf_count++;
    }

    /* When window is full, dump 100 JSONL lines to SD */
    if (buf_count >= CIRCULAR_BUFFER_SIZE) {
      static char json_buf[12800];
      char* p = json_buf;
      int   total = 0;

      for (uint32_t i = 0; i < CIRCULAR_BUFFER_SIZE; i++) {
        RTC_TimeTypeDef rt;
        RTC_DateTypeDef rd;
        HAL_RTC_GetTime(&hrtc, &rt, RTC_FORMAT_BIN);
        HAL_RTC_GetDate(&hrtc, &rd, RTC_FORMAT_BIN);
        uint32_t ms = circular_buffer[i].timestamp_ms % 1000u;

        int n = sprintf(p,
          "{\"timestamp\":\"20%02d-%02d-%02d %02d:%02d:%02d.%03lu\","
          "\"gyro\":{\"x\":%d,\"y\":%d,\"z\":%d},"
          "\"accel\":{\"x\":%d,\"y\":%d,\"z\":%d}}\r\n",
          rd.Year, rd.Month, rd.Date, rt.Hours, rt.Minutes, rt.Seconds, (unsigned long)ms,
          circular_buffer[i].ism330_gyro.x, circular_buffer[i].ism330_gyro.y, circular_buffer[i].ism330_gyro.z,
          circular_buffer[i].ism330_accel.x, circular_buffer[i].ism330_accel.y, circular_buffer[i].ism330_accel.z
        );
        p     += n;
        total += n;
      }

      uint32_t t0 = HAL_GetTick();
      fx_file_write(&log_file, json_buf, (ULONG)total);
      fx_media_flush(&sd_media);             /* force commit to SD card */
      uint32_t dt = HAL_GetTick() - t0;

      /* Optional UART debug (kept short; comment out if not needed) */
      /* char dbg[80];
         int len = sprintf(dbg, "Wrote 100 lines in %lu ms\r\n", (unsigned long)dt);
         HAL_UART_Transmit(&huart2, (uint8_t*)dbg, len, 50); */

      buf_count = 0;
      /* Optionally sleep */
      /* __WFI(); */
    }
  }
  /* USER CODE END 3 */

}
