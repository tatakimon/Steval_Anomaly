/**
  * @brief  Application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();
  SystemPower_Config();
  SystemClock_Config();
  PeriphCommonClock_Config();

  /* Initialize only the peripherals we actually use */
  MX_GPIO_Init();
  MX_GPDMA1_Init();
  MX_ICACHE_Init();
  MX_RTC_Init();
  MX_SDMMC1_SD_Init();
  MX_SPI2_Init();
  MX_TAMP_RTC_Init();
  MX_USART2_UART_Init();
  MX_FileX_Init();

  /* USER CODE BEGIN 2 */
  /* --- (Optional) Set a known RTC date/time once after boot.
     If you already set RTC elsewhere or via backup registers, you can remove this block. */
  {
    RTC_TimeTypeDef sTime = {0};
    RTC_DateTypeDef sDate = {0};
    sTime.Hours   = 16;
    sTime.Minutes = 39;
    sTime.Seconds = 0;
    sTime.DayLightSaving  = RTC_DAYLIGHTSAVING_NONE;
    sTime.StoreOperation  = RTC_STOREOPERATION_RESET;
    HAL_RTC_SetTime(&hrtc, &sTime, RTC_FORMAT_BIN);

    sDate.WeekDay = RTC_WEEKDAY_FRIDAY;
    sDate.Month   = RTC_MONTH_SEPTEMBER;
    sDate.Date    = 19;
    sDate.Year    = 25;                 // 2025
    HAL_RTC_SetDate(&hrtc, &sDate, RTC_FORMAT_BIN);
  }

  /* Bring up ISM330DHCX (BDU+auto-inc, ODR ≈ 1 kHz) */
  Initialize_Sensors();

  /* First DMA read will happen in the main loop pacing gate */
  /* --- FileX: mount SD, open/create log file once and seek to end --- */
  {
    UINT status = fx_media_open(&sd_media, "SD_DISK",
                                fx_stm32_sd_driver, (VOID*)&hsd1,
                                media_buffer, sizeof(media_buffer));
    if (status != FX_SUCCESS) { Error_Handler(); }

    status = fx_file_open(&sd_media, &log_file, "datalog.jsonl", FX_OPEN_FOR_WRITE);
    if (status == FX_NOT_FOUND) {
      fx_file_create(&sd_media, "datalog.jsonl");
      status = fx_file_open(&sd_media, &log_file, "datalog.jsonl", FX_OPEN_FOR_WRITE);
    }
    if (status != FX_SUCCESS) { Error_Handler(); }

    /* Append mode: jump to end once */
    fx_file_seek(&log_file, log_file.fx_file_current_file_size);
  }
  /* USER CODE END 2 */

  /* Infinite loop -----------------------------------------------------------*/
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* 1) 1 kHz pacing: start a fresh SPI2 DMA read every ~1 ms (non-blocking) */
    if ((HAL_GetTick() - last_sample_time) >= 1U) {
      last_sample_time = HAL_GetTick();
      start_sensor_read();
    }

    /* 2) When DMA completes, parse and push into ring buffer */
    if (g_data_ready) {
      g_data_ready = 0;

      SensorSample_t s;
      s.timestamp_ms = HAL_GetTick();

      /* Parse interleaved gyro+accel (little endian) */
      s.ism330_gyro.x  = (int16_t)((ism330dhcx_rx_buffer[1]  << 8) | ism330dhcx_rx_buffer[0]);
      s.ism330_gyro.y  = (int16_t)((ism330dhcx_rx_buffer[3]  << 8) | ism330dhcx_rx_buffer[2]);
      s.ism330_gyro.z  = (int16_t)((ism330dhcx_rx_buffer[5]  << 8) | ism330dhcx_rx_buffer[4]);
      s.ism330_accel.x = (int16_t)((ism330dhcx_rx_buffer[7]  << 8) | ism330dhcx_rx_buffer[6]);
      s.ism330_accel.y = (int16_t)((ism330dhcx_rx_buffer[9]  << 8) | ism330dhcx_rx_buffer[8]);
      s.ism330_accel.z = (int16_t)((ism330dhcx_rx_buffer[11] << 8) | ism330dhcx_rx_buffer[10]);

      circular_buffer[buffer_head] = s;
      buffer_head = (buffer_head + 1U) % CIRCULAR_BUFFER_SIZE;
      if (buffer_count < CIRCULAR_BUFFER_SIZE) { buffer_count++; }
    }

    /* 3) When window is full, serialize 100 JSON lines and write once to SD */
    if (buffer_count >= CIRCULAR_BUFFER_SIZE) {
      static char json_buffer[12800]; /* ~128 bytes * 100 lines headroom */
      char*  p   = json_buffer;
      int    total_bytes = 0;

      for (int i = 0; i < CIRCULAR_BUFFER_SIZE; i++) {
        RTC_TimeTypeDef t;
        RTC_DateTypeDef d;
        HAL_RTC_GetTime(&hrtc, &t, RTC_FORMAT_BIN);
        HAL_RTC_GetDate(&hrtc, &d, RTC_FORMAT_BIN);

        uint32_t ms = circular_buffer[i].timestamp_ms % 1000U;

        int n = sprintf(p,
            "{\"timestamp\":\"20%02d-%02d-%02d %02d:%02d:%02d.%03lu\","
            "\"gyro\":{\"x\":%d,\"y\":%d,\"z\":%d},"
            "\"accel\":{\"x\":%d,\"y\":%d,\"z\":%d}}\r\n",
            d.Year, d.Month, d.Date,
            t.Hours, t.Minutes, t.Seconds, (unsigned long)ms,
            circular_buffer[i].ism330_gyro.x,  circular_buffer[i].ism330_gyro.y,  circular_buffer[i].ism330_gyro.z,
            circular_buffer[i].ism330_accel.x, circular_buffer[i].ism330_accel.y, circular_buffer[i].ism330_accel.z);
        p           += n;
        total_bytes += n;
      }

      uint32_t t0 = HAL_GetTick();
      fx_file_write(&log_file, json_buffer, (ULONG)total_bytes);
      /* Force media flush so data lands physically on SD (safer on power loss) */
      fx_media_flush(&sd_media);
      (void)t0; /* keep if you re-enable UART timing print */

      /* Ready for next window */
      buffer_count = 0;
    }

    /* Optionally sleep here (WFI) if you want lower power */
    // __WFI();
  }
  /* USER CODE END WHILE */
}

